{
    "configurations": [
        {
            "name": "MinGW",
            "compilerPath": "g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/lib",
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/_deps/httplib-src",
                "${workspaceFolder}/build/_deps/nlohmann_json-src/include"
            ],
            "defines": [
                "NOMINMAX"
            ],
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}
