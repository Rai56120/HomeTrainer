{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/backend",
                "-B", "${workspaceFolder}/backend/build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure the project with CMake using the MinGW Makefiles generator."
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/backend/build",
                "--config", "Release",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "cmake: configure",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build HomeTrainer using the configured build system (default build task)."
        },
        {
            "label": "cmake: clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/backend/build",
                "--target", "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Remove compiled objects and binaries, keep CMake cache."
        },
        {
            "label": "cmake: rebuild",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/backend/build",
                "--config", "Release",
                "-j"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["cmake: configure", "cmake: clean"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"],
            "detail": "Reconfigure, clean compiled outputs, then rebuild all targets."
        },
        {
            "label": "run: HomeTrainer",
            "type": "process",
            "command": "${workspaceFolder}/backend/build/HomeTrainer.exe",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "dependsOn": "cmake: build",
            "problemMatcher": [],
            "detail": "Build if needed, then run HomeTrainer.exe."
        },
        {
            "label": "cmake: test",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "${workspaceFolder}/backend/build",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "dependsOn": "cmake: build",
            "problemMatcher": [],
            "group": "test",
            "detail": "Build if needed, then run the CTest suite."
        }
    ]
}